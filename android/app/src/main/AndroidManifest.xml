<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Required because AudioPlaybackCapture is delivered through AudioRecord. The microphone is
        never opened: the capture is configured for this app's own UID only.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        This app is handed round as an APK rather than installed from a store, so it updates itself:
        it downloads the new build and asks the system installer to put it on. Without this the only
        way to ship a fix is to ask everyone to download it again by hand.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TastyRadioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TastyRadio">

        <!--
            singleTask so a mix link tapped while the app is already open arrives at the running
            instance through onNewIntent, instead of stacking a second copy on top of a playing mix.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TastyRadio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                A shared mix. The whole mix is in the link's fragment (see share/MixLink.kt), and
                this filter is what makes tapping one open the app rather than the browser — with no
                "open with?" dialog, because autoVerify checks this build's signing certificate
                against https://radio.truthseekersbyo.com/.well-known/assetlinks.json.

                Scoped to /m and /s/ rather than the whole host on purpose: claiming everything
                would mean a link to the website itself opened the app instead of the site. A phone
                without the app installed follows the same link to the web desk, which plays the
                same mix.

                /s/ is the short form — the mix is on the server and the key to it is in the
                fragment. Builds older than this one don't claim it and hand it to the browser,
                which opens the same mix on the web desk. Nothing to fix, just a longer way round.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="radio.truthseekersbyo.com"
                    android:pathPrefix="/m" />
                <data
                    android:scheme="https"
                    android:host="radio.truthseekersbyo.com"
                    android:pathPrefix="/s/" />
            </intent-filter>

            <!--
                A mix shared *into* the app. Links arrive inside WhatsApp and Messenger as often as
                they arrive as taps, and those open links in their own in-app browser — from which
                "Share → Tasty Radio" is the way out.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Playback lives in a foreground service, not the Activity. Doing it in the Activity
            appears to work in testing and then gets killed in real use.
        -->
        <service
            android:name=".playback.SoundscapeService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            Recording lives in its own foreground service because it needs the mediaProjection
            type, while playback's MediaSessionService owns its own notification.
        -->
        <service
            android:name=".record.RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            Hands the downloaded update to the system installer. A file:// URI would be refused
            outright on anything modern, so the installer gets a granted content:// URI instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
