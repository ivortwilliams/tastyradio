# Copy to keystore.properties (gitignored) and point it at your own keystore, generated with:
#   keytool -genkeypair -keystore tastyradio-release.jks -alias tastyradio \
#           -keyalg RSA -keysize 4096 -validity 10000
# Every release APK must be signed with the same key, or it won't install over the previous one.
storeFile=tastyradio-release.jks
storePassword=changeme
keyAlias=tastyradio
keyPassword=changeme
