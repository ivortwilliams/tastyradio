# ---- Android (android/) ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/
release/
output.json
.kotlin/

# Keystores / signing — never commit these
*.jks
*.keystore
keystore.properties
signing.properties

# ---- Web (web/) ----
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
# The station index and anything else the server writes at runtime.
web/server/data/
# A built index is 34 MB of generated data; it is published as a release asset, not committed.
web/server/out/
# Vite builds the client straight into here. Generated, never edited, never committed —
# note this is NOT web/client/public/, which holds real source assets like Ophelia.
web/server/public/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.navigation/
.vscode/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Env / secrets ----
.env
.env.*
!.env.example
